<%- include("partials") %><main class="section"><div class="container"><div class="eyebrow">ONLINE STORE</div><h2>Shop parts</h2><form class="filters" method="get"><input class="input" name="q" value="<%=q%>" placeholder="Search parts..."><select name="category" onchange="this.form.submit()"><option>All</option><%cats.forEach(c=>{ %><option <%=category===c?"selected":""%>><%=c%></option><%})%></select><button class="btn dark">Search</button></form><div class="grid"><%products.forEach(p=>{ %><article class="card"><a href="/product/<%=p.id%>"><div class="product-img"><%=p.image%></div><div class="cat"><%=p.category%></div><h3><%=p.name%></h3><p class="muted"><%=p.description%></p><div class="price">R<%=Number(p.price).toFixed(2)%></div></a><a class="btn dark" style="margin-top:12px" href="/checkout?ids=<%=p.id%>">Buy now</a></article><%})%></div></div></main><footer class="footer"><div class="container">Matt Technologies</div></footer>
