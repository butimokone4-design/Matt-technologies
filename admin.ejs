<%- include("partials") %><main class="section"><div class="container"><div class="eyebrow">ADMIN DASHBOARD</div><h2>Matt Technologies Store Manager</h2><div class="admin-grid"><div class="box"><h3>Add product</h3><form class="form" method="post" action="/admin/product"><input class="input" name="name" placeholder="Product name" required><input class="input" name="category" placeholder="Category" required><textarea name="description" placeholder="Description"></textarea><div class="two"><input class="input" name="price" type="number" step="0.01" placeholder="Price" required><input class="input" name="stock" type="number" placeholder="Stock" required></div><input class="input" name="image" placeholder="Emoji or image URL"><button class="btn primary">Add product</button></form></div><div class="box"><h3>Store overview</h3><p>Products: <b><%=products.length%></b></p><p>Customers: <b><%=customerCount%></b></p><p>Orders: <b><%=orders.length%></b></p></div></div><div class="box" style="margin-top:25px"><h3>Orders</h3><table class="table"><tr><th>#</th><th>Customer</th><th>Total</th><th>Status</th><th>Update</th></tr><%orders.forEach(o=>{%><tr><td>#<%=o.id%></td><td><%=o.customer_name%><br><small><%=o.email%></small></td><td>R<%=Number(o.total).toFixed(2)%></td><td><%=o.status%><br><%=o.payment_status%></td><td><form method="post" action="/admin/order/<%=o.id%>"><select name="status"><option>pending</option><option>processing</option><option>shipped</option><option>completed</option><option>cancelled</option></select><select name="payment_status"><option>unpaid</option><option>paid</option><option>refunded</option></select><button class="btn dark">Save</button></form></td></tr><%})%></table></div><div class="box" style="margin-top:25px"><h3>Products</h3><table class="table"><tr><th>Product</th><th>Price</th><th>Stock</th><th>Active</th><th>Save</th></tr><%products.forEach(p=>{%><tr><form method="post" action="/admin/product/<%=p.id%>"><td><input class="input" name="name" value="<%=p.name%>"><input class="input" name="category" value="<%=p.category%>"><textarea name="description"><%=p.description%></textarea></td><td><input class="input" name="price" value="<%=p.price%>"></td><td><input class="input" name="stock" value="<%=p.stock%>"></td><td><input type="checkbox" name="active" <%=p.active?"checked":""%>></td><td><button class="btn dark">Save</button></td></form></tr><%})%></table></div></div></main>
