<%- include("partials") %><main class="section"><div class="container" style="max-width:800px"><div class="success"><h2>Order #<%=order.id%> received</h2><p>Thank you, <%=order.customer_name%>. Your order status is <b><%=order.status%></b>.</p><p>Payment status: <b><%=order.payment_status%></b></p></div><div class="box" style="margin-top:20px"><h3>Items</h3><%items.forEach(i=>{%><div class="line"><span><%=i.name%> × <%=i.quantity%></span><b>R<%=(Number(i.unit_price)*i.quantity).toFixed(2)%></b></div><%})%><div class="line"><strong>Total</strong><strong>R<%=Number(order.total).toFixed(2)%></strong></div><p class="muted">For faster processing, contact Matt Technologies on WhatsApp with order #<%=order.id%>.</p><a class="btn primary" href="https://wa.me/<%=whatsapp%>?text=Hello%20Matt%20Technologies%2C%20my%20order%20is%20%23<%=order.id%>" target="_blank">WhatsApp about order</a></div></div></main>
