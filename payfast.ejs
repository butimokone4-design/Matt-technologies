<%- include("partials") %><main class="section"><div class="container" style="max-width:650px"><div class="box"><div class="eyebrow">SECURE PAYMENT</div><h2>Continue to PayFast</h2><p class="muted">Your order #<%=orderId%> has been created. You will be redirected to PayFast to complete payment.</p><form id="pf" method="post" action="<%=sandbox?'https://sandbox.payfast.co.za/eng/process':'https://www.payfast.co.za/eng/process'%>"><input type="hidden" name="merchant_id" value="<%=merchantId%>"><input type="hidden" name="merchant_key" value="<%=merchantKey%>"><input type="hidden" name="amount" value="<%=Number(total).toFixed(2)%>"><input type="hidden" name="item_name" value="Matt Technologies Order #<%=orderId%>"><input type="hidden" name="m_payment_id" value="<%=orderId%>"><input type="hidden" name="return_url" value="<%=process.env.PAYFAST_RETURN_URL%>"><input type="hidden" name="cancel_url" value="<%=process.env.PAYFAST_CANCEL_URL%>"><input type="hidden" name="notify_url" value="<%=process.env.PAYFAST_NOTIFY_URL%>"><button class="btn primary">Pay now</button></form></div></div><script>document.getElementById("pf").submit()</script>
