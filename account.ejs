<%- include("partials") %><main class="section"><div class="container"><div class="eyebrow">MY ACCOUNT</div><h2>My orders</h2><div class="box"><table class="table"><tr><th>Order</th><th>Date</th><th>Total</th><th>Status</th></tr><%orders.forEach(o=>{%><tr><td><a href="/order/<%=o.id%>">#<%=o.id%></a></td><td><%=new Date(o.created_at).toLocaleDateString("en-ZA")%></td><td>R<%=Number(o.total).toFixed(2)%></td><td><%=o.status%> / <%=o.payment_status%></td></tr><%})%></table></div></div></main>
