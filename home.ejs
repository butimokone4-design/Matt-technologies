<%- include("partials") %>
<section class="hero"><div class="container hero-grid"><div><div class="eyebrow">ELECTRONIC PARTS • SOUTH AFRICA</div><h1>Parts that keep your <span>technology</span> working.</h1><p>Shop TV parts, cellphone spares, electronic components and repair tools from Matt Technologies.</p><div class="actions"><a class="btn primary" href="/shop">Shop now</a><a class="btn light" href="/shop?category=TV+Parts">TV parts</a></div></div><div class="hero-art"><div>MT</div></div></div></section>
<section class="section"><div class="container"><div class="eyebrow">FEATURED</div><h2>Popular parts</h2><div class="grid"><% products.slice(0,8).forEach(p=>{ %><a class="card" href="/product/<%=p.id%>"><div class="product-img"><%=p.image%></div><div class="cat"><%=p.category%></div><h3><%=p.name%></h3><div class="price">R<%=Number(p.price).toFixed(2)%></div></a><% }) %></div></div></section>
<section class="section" style="background:#fff"><div class="container"><div class="two"><div><div class="eyebrow">WHOLESALE SOURCING</div><h2>Need a part we don't list?</h2><p class="muted">Send Matt Technologies your model number, board number or a photo. We can help source compatible parts through our supplier network.</p></div><div class="box"><h3>Request a part</h3><p class="muted">WhatsApp us for product sourcing and bulk enquiries.</p><a class="btn primary" href="https://wa.me/<%=whatsapp%>" target="_blank">WhatsApp Matt Technologies</a></div></div></div></section>
<footer class="footer"><div class="container">© 2026 Matt Technologies • TV & cellphone electronic parts</div></footer>
