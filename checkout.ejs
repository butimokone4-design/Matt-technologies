<%- include("partials") %><main class="section"><div class="container"><div class="eyebrow">CHECKOUT</div><h2>Complete your order</h2><%if(error){%><div class="notice"><%=error%></div><%}%><form method="post" class="checkout-grid"><div class="box"><div class="form"><input type="hidden" name="product_ids" value="<%=products.map(p=>p.id).join(',')%>"><input type="hidden" name="quantities" value="<%=products.map(()=>1).join(',')%>"><div class="two"><input class="input" name="name" value="<%=user.name%>" placeholder="Name" required><input class="input" name="phone" value="<%=user.phone||''%>" placeholder="Phone / WhatsApp" required></div><input class="input" name="email" value="<%=user.email%>" type="email" required><input class="input" name="address" placeholder="Delivery address" required><div class="two"><input class="input" name="city" placeholder="City" required><input class="input" name="postal_code" placeholder="Postal code" required></div><label>Payment method<select name="payment_method"><option value="whatsapp">WhatsApp / payment arrangement</option><option value="payfast">PayFast online payment</option></select></label><button class="btn primary">Place order</button></div></div><div class="box"><h3>Order summary</h3><%let total=0;products.forEach(p=>{total+=Number(p.price);%><div class="line"><span><%=p.name%></span><b>R<%=Number(p.price).toFixed(2)%></b></div><%})%><div class="line"><strong>Total</strong><strong>R<%=total.toFixed(2)%></strong></div></div></form></div></main>
